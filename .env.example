# Copy to .env.local (local dev) or set in your host's dashboard (Vercel / Netlify).
# All are public build-time values: they are baked into the static HTML at build.

# Your live domain, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.phoenixdigital.co.ke

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA4_ID=

# Where the contact form posts (Formspree: https://formspree.io/f/xxxxxxx, or any endpoint that accepts JSON).
# If empty, forms fall back to opening the visitor's email app.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: a separate endpoint for The Common forms (tickets, vendor slots, venue ideas).
# Falls back to NEXT_PUBLIC_FORM_ENDPOINT when empty.
NEXT_PUBLIC_COMMON_FORM_ENDPOINT=
